# SmartShop Frontend Environment Configuration Example
# Copy this file to .env.local and populate with your keys
# Never commit your actual API keys to GitHub!

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8080

# Google Maps JavaScript API Key
# 1. Open Google Cloud Console (https://console.cloud.google.com/)
# 2. Select or create your project and enable billing
# 3. Enable "Maps JavaScript API" and "Directions API"
# 4. Create an API key and restrict it to http://localhost:5173/*
# 5. Put your key below in .env.local
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
